// Wavelength — data model
// Every team-owned row hangs off Team so multi-team support later is additive.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id        String      @id @default(cuid())
  name      String
  groups    Group[]
  events    TeamEvent[]
  createdAt DateTime    @default(now())
}

model Group {
  id             String  @id @default(cuid())
  teamId         String
  team           Team    @relation(fields: [teamId], references: [id])
  name           String
  ageRange       String?
  targetStandard String? // e.g. "100 free pacing on 1:20 by March"
  // Freeform coaching instructions the coach writes/edits themselves and that
  // feed straight into every generation prompt — how they steer the AI
  // without a developer changing code (tone, drill rules, set volume, etc).
  preferences    String?

  swimmers      Swimmer[]
  styleExamples StyleExample[]
  goalMeets     GoalMeet[]
  drills        DrillEntry[]
  practices     Practice[]

  createdAt DateTime @default(now())
}

// Team-wide calendar: big meets, time trials — anything that isn't scoped
// to one group's own practice schedule.
model TeamEvent {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  name      String
  date      DateTime
  type      String   @default("meet") // "meet" | "time_trial" | "other"
  notes     String?
  createdAt DateTime @default(now())
}

model Swimmer {
  id         String       @id @default(cuid())
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  gender     String? // "F" | "M" | "Other" — coach's own roster categories, not enforced
  times      SwimTime[]
  attendance Attendance[]

  createdAt DateTime @default(now())
}

model SwimTime {
  id         String   @id @default(cuid())
  swimmerId  String
  swimmer    Swimmer  @relation(fields: [swimmerId], references: [id], onDelete: Cascade)
  event      String // e.g. "100 Free", "200 IM"
  kind       String // "current" | "goal"
  seconds    Float
  recordedAt DateTime @default(now())
}

model StyleExample {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  content   String // the practice itself, as the coach wrote it
  createdAt DateTime @default(now())
}

model GoalMeet {
  id              String   @id @default(cuid())
  groupId         String
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  date            DateTime
  taperWeeks      Int      @default(2)
  attendanceNotes String? // coach's own rule of thumb, e.g. "4x/week -> low 30s, 6x/week -> mid 20s"
  createdAt       DateTime @default(now())
}

model DrillEntry {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  definition String
  createdAt  DateTime @default(now())
}

model Practice {
  id         String       @id @default(cuid())
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  focus      String?
  content    String // full generated practice, markdown
  intervals  String? // JSON: per-swimmer A/B/C intervals per set
  source     String       @default("template") // "template" | "claude" | "manual"
  date       DateTime     @default(now()) // the calendar day this practice is FOR — may be scheduled ahead
  // Free text, not a strict time type — coaches write "6:00 AM", "4:30pm",
  // "morning", whatever matches how they'd actually say it. Useful for clubs
  // running more than one session a day for the same group.
  timeOfDay  String?
  createdAt  DateTime     @default(now()) // when it was actually generated/entered
  attendance Attendance[]
}

// One row per swimmer per practice, written when the coach saves attendance
// for that day — defaults to present; the coach only has to touch who wasn't
// there. No row yet just means attendance hasn't been taken for that practice.
model Attendance {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  swimmerId  String
  swimmer    Swimmer  @relation(fields: [swimmerId], references: [id], onDelete: Cascade)
  present    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([practiceId, swimmerId])
}
